export TF_VAR_cloudflare_api_token="$(security find-generic-password -s cloudflare-token -a finances -w)"
export TF_VAR_cloudflare_zone_id="$(security find-generic-password -s cloudflare-zone-id -a finances -w)"
export TF_VAR_jev_api_key="$(security find-generic-password -s jev-api-key -a finances -w)"
# BFF's own authentication: token signing key and the admin key for Postman.
# Create once with:
#   security add-generic-password -s bff-jwt-secret -a finances -w "$(openssl rand -base64 48)"
#   security add-generic-password -s bff-admin-api-key -a finances -w "$(openssl rand -base64 48)"
export TF_VAR_bff_jwt_secret="$(security find-generic-password -s bff-jwt-secret -a finances -w)"
export TF_VAR_bff_admin_api_key="$(security find-generic-password -s bff-admin-api-key -a finances -w 2>/dev/null)"
